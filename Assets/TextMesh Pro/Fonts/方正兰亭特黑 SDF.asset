    atlasWidth: 2048
    atlasHeight: 2048
    characterSetSelectionMode: 8
    characterSequence: "\u5F00\u59CB\u6E38\u620F\u5236\u4F5C\u4EBA\u540D\u5355\u7A97\u53E3\u5316\u9000\u51FA\u65E0AI\u8BA4\u8BC1\u5956\u636E\u8BF4\u6B64\u5956\u7AE0\u975E\u5E38\u7A00\u6709\uFF0C\u53EA\u9881\u53D1\u7ED9\u6CA1\u6709\u7528AI\u7684\u5F00\u53D1\u8005\u5DEB\u5E08\u7684\u6536\u85CF\u54C1\u5236\u4F5C\u4EBA\u540D\u5355\uFF1A\u5173\u79FB\u65CB\u4E3B\u83DC\u8001\u529F\u5947\u8001\u6CD5\u5E08\u4ECE\u6B64\u9500\u58F0\u533F\u8FF9\u4E45\r\n\u5927\u6CD5\u5E08:
      \u4F60\u7B7E\u540D\u4E86\uFF0C\u5BF9\u5427\uFF1F\r\n\u5927\u6CD5\u5E08: \u90A3\u4E48\u5951\u7EA6\u5B8C\u6210\u54AF\u3002\r\n\u5927\u6CD5\u5E08:
      \u54C8\u54C8\uFF0C\u6C38\u8FDC\u4E0D\u80FD\u8FDD\u7EA6\u7684\u5F1F\u5B50\uFF0C\u73B0\u5728\u662F\u6211\u7684\u6240\u6709\u7269\u4E86\u3002\r\n\u5927\u6CD5\u5E08:
      \u73B0\u5728\uFF0C\u6765\u5E2E\u6211\u4E00\u4E2A\u5FD9\u5427\u3002\r\n\u5927\u6CD5\u5E08:
      \u6211\u9A6C\u4E0A\u8981\u51FA\u95E8\u4E86\uFF0C \u5E2E\u6211\u6536\u62FE\u4E00\u4E0B\u884C\u674E\u5427\u3002\r\n\u5927\u6CD5\u5E08:
      \u8FD9\u70B9\u5C0F\u4E8B\uFF0C\u5E94\u8BE5\u4E0D\u7B97\u96BE\u5427\uFF1F\r\n\u5927\u6CD5\u5E08:
      \u53EA\u662F\u4ED6\u4EEC\u6709\u4E9B\u987D\u76AE\uFF0C\u4F1A\u81EA\u5DF1\u4E71\u8DD1\uFF0C\u4F60\u53EA\u8981\u628A\u4ED6\u4EEC\u6293\u4F4F\u653E\u5230\u80CC\u5305\u91CC\u5C31\u884C\u4E86\u3002\u5F88\u7B80\u5355\u7684\uFF0C
      \u53EF\u4EE5\u505A\u5230\u7684\u5427\u3002\r\n\u5927\u6CD5\u5E08: \u4E3A\u4EC0\u4E48\u4ED6\u4EEC\u770B\u8D77\u6765\u50CF\u6D3B\u7684\uFF1F\u8FD9\u4E0D\u662F\u91CD\u70B9\r\n\u5927\u6CD5\u5E08:
      \u8FD9\u4E9B\u9053\u5177\u6211\u51FA\u95E8\u7684\u65F6\u5019\u90FD\u4F1A\u7528\u5230\uFF0C\u5982\u679C\u80FD\u8FBE\u5230\u76EE\u6807\u9B54\u529B\u503C\u80CC\u5305\u5C31\u4F1A\u76F4\u63A5\u5408\u4E0A\uFF0C\u4F60\u5C31\u6210\u529F\u4E86\uFF01\u4F46\u662F..\u5343\u4E07\u4E0D\u8981\u8FDE\u6700\u4F4E\u9700\u6C42\u7684\u9B54\u529B\u503C\u90FD\u8FBE\u4E0D\u5230\u54E6\r\n\u5927\u6CD5\u5E08:
      \u90A3\u6211\u53BB\u4E0A\u4E2A\u5395\u6240\u5C31\u56DE\u6765\u54E6\u3002\r\n\r\n\u6CD5\u5E08\uFF1A\u5B69\u5B50,
      \u8FD9\u4E00\u5207\u7ED3\u675F\u4E86, \u4F60\u662F\u4E00\u4E2A\u4F18\u79C0\u7684\u5BB9\u5668...\u6211\u662F\u8BF4\uFF0C\u5F92\u5F1F\r\n\u4F60:
      \u53EF\u662F\uFF0C\u8FD9\u6BD4\u6211\u60F3\u8C61\u7684\u8FD8\u8981\u77ED\r\n\u5927\u6CD5\u5E08:
      \u662F\u7684, \u56E0\u4E3A\u5728Game Jam\u4E0A\u505A\u7684\u6E38\u620F\u5C31\u4E0D\u8BE5\u592A\u957F\r\n\u4F60\u65E0\u6CD5\u627F\u53D7\u8FD9\u53EA\u662FGame
      Jam\u7684\u5DE8\u5927\u5669\u8017, \u65E0\u52A9\u7684\u53CC\u819D\u8DEA\u5730\u62B1\u5934\u75DB\u54ED,
      \u96BE\u4EE5\u63A5\u53D7\u73A9\u4E0D\u5230\u6B63\u5F0F\u7248\u7684\u6CAE\u4E27\r\n\r\nidle,\u6211\u66FE\u7ECF\u662F\u4E2A\u53EB$PlayerName$\u7684\u9B54\u6CD5\u5E08\u5B66\u5F92\uFF0C\u76F4\u5230\u6211\u88AB\u5C01\u5370\u5728\u8FD9\u4E2A\u73A9\u5076\u91CC\u3002\r\nidle,\u6211\u4E5F\u53EB\u505A$PlayerName$\uFF0C\u4F46\u73B0\u5728\u6211\u53EA\u662F\u4E00\u4E2A\u88AB\u9057\u5FD8\u7684\u73A9\u5076\u3002\r\nidle,$PlayerName$\uFF01\u4E0D\u8981\u76F8\u4FE1\u90A3\u4E2A\u8BE5\u6B7B\u7684\u8001\u6CD5\u5E08\uFF01\u8BA9\u6211\u51FA\u6765\uFF01\r\n\r\nDerek
      \u5168\u6751\u5E0C\u671B \u7A0B\u5E8F\r\n\u5C0F\u5F71 \u6CD5\u5E08 \u63D2\u753B\u7F8E\u672F\r\nCheshirecrow
      \u6CD5\u5E08\u5B66\u5F92\uFF08\u4E0A\u4E00\u4EFB\uFF09UI\u7F8E\u672F\r\nDogfish
      \u5E55\u540E\u795E\u79D8\u4EBA \u7A0B\u5E8F\r\nLan \u8BF4\u4E66\u4EBA \u5BF9\u8BDD/\u7A0B\u5E8F\r\n\u786E\u5B9A\u8FD4\u56DE\u8FD9\u4E2ADemo\u53EA\u652F\u6301\u8F93\u5165\u82F1\u6587\r\n\u6CA1\u60F3\u5230\u5427\uFF01\u5851\u5F62\u586B\u5199\u4F60\u4F5C\u4E3A\u9B54\u6CD5\u5B66\u5F92\u7684\u540D\u5B57\r\n\u5927\u6CD5\u5E08:
      \u4F60\u9192\u5566\r\n\u5927\u6CD5\u5E08: \u5728\u8FD9\u91CC\u8F93\u5165\u4F60\u7684\u540D\u5B57\u5427\r\n\r\nstate,text\r\nidle,\u98CE\u5E26\u6211\u8D70\uFF0C\u53BB\u5BFB\u627E\u66FE\u7ECF\u7684\u5C71\u6797\u3002\r\nidle,\u6211\u542C\u89C1\u843D\u53F6\u8BF4\u8BDD\uFF0C\u4F60\u542C\u4E0D\u89C1\u5427\u3002\r\nidle,\u4F60\u8E0F\u8FC7\u7684\u8349\u5730\uFF0C\u8BB0\u5F97\u6211\u66FE\u5954\u8DD1\u8FC7\u7684\u5F71\u5B50\u3002\r\nidle,\u6211\u8FD8\u80FD\u611F\u89C9\u5230\u8FDC\u53E4\u68EE\u6797\u7684\u547C\u5438\u3002\r\nsleep,\u6211\u5728\u6C89\u7720\u4E2D\u91CD\u6E29\u65E7\u68A6\uFF0C\u90A3\u65F6\u4E00\u5207\u90FD\u8FD8\u6D3B\u7740\u3002\r\nsleep,\u6211\u672C\u5C5E\u4E8E\u5929\u7A7A\u4E0E\u96EA\u5730\uFF0C\u4E0D\u5C5E\u4E8E\u5E03\u888B\u3002\r\nsleep,\u8FDE\u58F0\u97F3\u90FD\u5F00\u59CB\u53D8\u5F97\u9065\u8FDC\u2026\u2026\u4F60\u542C\u5F97\u89C1\u6211\u5417\uFF1F\r\nsleep,\u6211\u5DF2\u9759\u6B62\u4E0D\u52A8\uFF0C\u4F46\u5C71\u6797\u8FD8\u5728\u5954\u8DD1\u3002\r\ngrab,\u522B\u518D\u89E6\u78B0\u6211\uFF0C\u9664\u975E\u4F60\u662F\u4E3A\u4E86\u796D\u7940\u3002\r\ngrab,\u4F60\u60F3\u7528\u6211\u505A\u6B66\u5668\uFF1F\r\ngrab,\u6BCF\u4E00\u6B21\u88AB\u6536\u8D77\uFF0C\u6211\u7684\u8BB0\u5FC6\u5C31\u66F4\u6A21\u7CCA\u4E00\u5206\u3002\r\ngrab,\u4F60\u4E0D\u914D\u6234\u6211\u2014\u2014\u81F3\u5C11\u4ECA\u5929\u8FD8\u4E0D\u914D\u3002\r\n\r\nstate,text\r\nidle,\u653E\u5F00\u6211\u51FA\u53BB\uFF0C\u6211\u8981\u53BB\u780D\u70B9\u4EC0\u4E48\uFF01\r\nidle,\u6709\u6CA1\u6709\u4EBA\u60F3\u4F53\u9A8C\u4E00\u4E0B\u7EAF\u6B63\u7684\u94A2\u94C1\u4EB2\u543B\uFF1F\r\nidle,\u4F60\u597D\uFF0C\u6211\u80FD\u780D\u4F60\u5417\uFF1F\r\nidle,\u780D\u4EBA\uFF01\u780D\u4EBA\uFF01\u780D\u4EBA\uFF01\r\nsleep,\u6211\u5728\u8FD9\u91CC\u9508\u6389\u4E5F\u6CA1\u4EBA\u7BA1\u5417\uFF1F\r\nsleep,\u6211\u505A\u68A6\u90FD\u5728\u5207\u756A\u8304\u2026\u2026\u4E0D\uFF0C\u662F\u8111\u888B\u3002\r\nsleep,\u5916\u9762\u6709\u6CA1\u6709\u6218\u4E89\u58F0\uFF1F\u8BA9\u6211\u542C\u542C\u2026\u2026\r\nsleep,\u6211\u4E0D\u662F\u5C55\u793A\u54C1\uFF0C\u6211\u662F\u6B66\u5668\uFF01\r\ngrab,\u522B\u52A8\u6211\uFF01\u5F53\u5FC3\u6211\u780D\u4F60\uFF01\r\ngrab,\u522B\u78B0\u6211\uFF01\u6211\u8FD8\u6CA1\u73A9\u591F\uFF01\r\ngrab,\u4F60\u52A8\u6211\u4E00\u4E0B\u8BD5\u8BD5\uFF01\r\ngrab,\u4E0D\u8981\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u554A\u2014\u2014\r\n\r\nstate,text\r\nidle,\u4F60\u80FD\u542C\u89C1\u6211\u5417\u2026\u2026\uFF1F\u6211\u2026\u2026\u597D\u5B64\u5355\u2026\u2026\r\nidle,\u5982\u679C\u4F60\u6253\u5F00\u74F6\u76D6\u2026\u2026\u6211\u4F1A\u966A\u4F60\u4E00\u8F88\u5B50\u2026\u2026\r\nidle,\u6211\u4E0D\u54AC\u4EBA\u2026\u2026\u771F\u7684\u2026\u2026\r\nidle,\u4F60\u662F\u2026\u2026\u597D\u4EBA\u5427\uFF1F\u6211\u770B\u5F97\u51FA\u6765\u2026\u2026\r\nsleep,\u653E\u6211\u51FA\u53BB\uFF01\uFF01\uFF01\u653E\u6211\u51FA\u53BB\u653E\u6211\u51FA\u53BB\u653E\u6211\u51FA\u53BB\u2014\u2014\uFF01\uFF01\uFF01\r\nsleep,\u6211\u8BB0\u4F4F\u4F60\u4E86\u2026\u2026\u4F60\u7684\u8138\u3001\u4F60\u7684\u58F0\u97F3\u3001\u4F60\u80CC\u5305\u7684\u6BCF\u4E00\u5BF8\u76AE\u9769\u3002\r\nsleep,\u55B5\u2026\u2026\u55B5\u2026\u2026\u55B5\u55B5\u55B5\u55B5\u55B5\u55B5\u55B5\u55B5\u55B5\uFF01\uFF01\uFF01\r\nsleep,\u4F60\u5728\u72B9\u8C6B\u4E86\u2026\u2026\u6211\u611F\u53D7\u5F97\u5230\u2026\u2026\r\ngrab,\u4F60\u662F\u4E0D\u662F\u4E5F\u88AB\u522B\u4EBA\u4E22\u4E0B\u8FC7\u2026\u2026\u6211\u4EEC\u662F\u4E00\u6837\u7684\u2026\u2026\r\ngrab,\u6211\u4E0D\u4F1A\u4F24\u5BB3\u4F60\u2026\u2026\u6211\u53EA\u662F\u2026\u2026\u592A\u5B64\u5355\u4E86\u2026\u2026\r\ngrab,\u6C42\u4F60\u4E86\u2026\u2026\u6211\u53EA\u60F3\u547C\u5438\u4E00\u6B21\u5916\u9762\u7684\u98CE\u2026\u2026\r\ngrab,\u4F60\u662F\u597D\u4EBA\u5BF9\u5427\u2026\u2026\u4F60\u662F\u552F\u4E00\u2026\u2026\u552F\u4E00\u8FD8\u542C\u89C1\u6211\u8BF4\u8BDD\u7684\u4EBA\u2026\u2026\r\n\r\nstate,text\r\nidle,\u6211\u7684\u6BDB\u8FD8\u6CA1\u68B3\uFF0C\u4F60\u522B\u60F3\u9A91\u3002\r\nidle,\u6211\u8FD9\u628A\u5237\u5B50\uFF0C\u662F\u7528\u6765\u98DE\u7684\uFF0C\u4E0D\u662F\u626B\u5730\u7684\uFF01\r\nidle,\u6211\u4E0A\u6B21\u5728\u5929\u4E0A\u8F6C\u5708\uFF0C\u7ED3\u679C\u4F60\u6655\u4E86\u4E09\u5929\u3002\r\nidle,\u554A\u2014\u2014\u81EA\u7531\u7684\u7A7A\u6C14\uFF01\u603B\u6BD4\u8DDF\u4F60\u5446\u4E00\u5757\u5F3A\u3002\r\nsleep,\u4F60\u4EE5\u4E3A\u5305\u91CC\u4E0D\u810F\u5417\uFF1F\u6211\u6BDB\u90FD\u5377\u8D77\u6765\u4E86\u3002\r\nsleep,\u628A\u6211\u6298\u8FDB\u5305\u91CC\u7684\u90A3\u4E00\u523B\uFF0C\u6211\u5DEE\u70B9\u65AD\u6210\u4E24\u8282\u3002\r\nsleep,\u98DE\u626B\u5408\u4E00\u624D\u662F\u6211\u7956\u4F20\u6280\u827A\uFF0C\u4F60\u53EA\u7528\u6765\u5835\u4ED3\u5E93\uFF1F\r\nsleep,\u55EF\u2026\u2026\u9ED1\u6697\uFF0C\u72ED\u7A84\uFF0C\u6CA1\u6709\u9B54\u6CD5\u5473\uFF0C\u6211\u8BA8\u538C\u8FD9\u5730\u65B9\u3002\r\ngrab,\u653E\u5F00\u6211\uFF0C\u9664\u975E\u4F60\u5B66\u4F1A\u771F\u6B63\u7684\u98DE\u884C\u672F\uFF01\r\ngrab,\u4F60\u7684\u5C41\u80A1\u538B\u6211\u538B\u5F97\u6211\u90FD\u5F2F\u4E86\uFF01\r\ngrab,\u4E0D\u884C\uFF01\u4F60\u53C8\u5FD8\u4E86\u64E6\u6211\u6BDB\u4E86\uFF01\r\ngrab,\u6211\u624D\u4E0D\u60F3\u548C\u90A3\u4E9B\u666E\u901A\u7269\u54C1\u6324\u5728\u4E00\u8D77\uFF01\r\n\r\nstate,text\r\nidle,\u76EE\u6807\u641C\u7D22\u4E2D\u2026\u2026\u522B\u6253\u6270\u6211\u6821\u51C6\u3002\r\nidle,\u98CE\u901F\u2026\u2026\u6E7F\u5EA6\u2026\u2026\u4E00\u5207\u5B8C\u7F8E\uFF0C\u53EA\u5DEE\u4E00\u51FB\u3002\r\nidle,\u522B\u8BEF\u4F1A\uFF0C\u6211\u4E0D\u662F\u4E3A\u4F60\u6218\u6597\uFF0C\u800C\u662F\u4E3A\u4E86\u5B8C\u7F8E\u7684\u4E00\u51FB\u3002\r\nidle,\u9759\u4E00\u70B9\uFF0C\u6211\u6B63\u5728\u503E\u542C\u654C\u4EBA\u7684\u5FC3\u8DF3\u58F0\u3002\r\nsleep,\u4F60\u4EE5\u4E3A\u6211\u559C\u6B22\u88AB\u585E\u8FDB\u8FD9\u4E2A\u9ED1\u6F06\u6F06\u7684\u5305\u91CC\uFF1F\r\nsleep,\u4F60\u9700\u8981\u7684\u4E0D\u662F\u52C7\u6C14\uFF0C\u662F\u5224\u65AD\u529B\uFF0C\u800C\u6211\u80FD\u63D0\u4F9B\u3002\r\nsleep,\u5C01\u5B58\u6211\uFF0C\u5C31\u662F\u653E\u5F03\u7CBE\u51C6\u3002\r\nsleep,\u6211\u6000\u5FF5\u7A7A\u6C14\u4E2D\u62C9\u5F26\u7684\u4E00\u77AC\u95F4\u3002\r\ngrab,\u7B49\u7B49\uFF0C\u4F60\u786E\u5B9A\u73B0\u5728\u662F\u4F11\u6218\u7684\u597D\u65F6\u673A\uFF1F\r\ngrab,\u6211\u4E0D\u662F\u73A9\u5177\uFF0C\u4E0D\u662F\u968F\u7528\u968F\u6536\u7684\u88C5\u9970\u3002\r\ngrab,\u4F60\u8FD9\u662F\u6218\u672F\u9000\u5374\uFF0C\u8FD8\u662F\u80C6\u602F\uFF1F\r\ngrab,\u6211\u8FD8\u672A\u547D\u4E2D\u4ECA\u65E5\u7684\u7B2C\u5341\u73AF\u3002\r\n\r\nstate,text\r\nidle,\u65F6\u95F4\u4E0D\u662F\u7528\u6765\u6293\u4F4F\u7684\uFF0C\u662F\u7528\u6765\u5931\u53BB\u7684\u3002\r\nidle,\u4F60\u52A8\u5F97\u8D8A\u5FEB\uFF0C\u9519\u8FC7\u7684\u8D8A\u591A\u3002\r\nidle,\u6211\u4E0D\u8BF4\u8BDD\u65F6\uFF0C\u4F60\u624D\u4F1A\u542C\u89C1\u771F\u6B63\u7684\u65F6\u95F4\u3002\r\nidle,\u7EE7\u7EED\u8F6C\u5427\u2026\u2026\u4F60\u603B\u4EE5\u4E3A\u65F6\u95F4\u7AD9\u5728\u4F60\u8FD9\u8FB9\u3002\r\nsleep,\u5728\u9ED1\u6697\u4E2D\uFF0C\u6211\u4F9D\u65E7\u5728\u8BA1\u6570\u3002\r\nsleep,\u6C89\u9ED8\u7684\u65F6\u95F4\uFF0C\u6BD4\u5C16\u53EB\u66F4\u53EF\u6015\u3002\r\nsleep,\u4F60\u9519\u8FC7\u7684\u4E1C\u897F\uFF0C\u6211\u90FD\u8BB0\u5F97\u3002\r\nsleep,\u9ED1\u6697\u4E0D\u662F\u9057\u5FD8\uFF0C\u800C\u662F\u7B49\u5F85\u3002\r\ngrab,\u4F60\u60F3\u628A\u65F6\u95F4\u85CF\u8D77\u6765\uFF1F\r\ngrab,\u4F60\u8FDE\u4E00\u5206\u949F\u90FD\u6293\u4E0D\u4F4F\r\ngrab,\u4F60\u8EB2\u5F97\u4E86\u4E00\u65F6\uFF0C\u8EB2\u4E0D\u4E86\u843D\u4E0B\u7684\u6700\u540E\u4E00\u7C92\u6C99\u3002\r\ngrab,\u65F6\u95F4\u4E0D\u4F1A\u7B49\u4F60\uFF0C\u6211\u4E5F\u4E0D\u4F1A\u3002\r\n\r\nstate,text\r\nidle,\u8C01\u628A\u6211\u4E22\u5728\u5730\u4E0A\uFF1F\u7B80\u76F4\u662F\u5BF9\u6CD5\u672F\u7684\u4FAE\u8FB1\uFF01\r\nidle,\u60F3\u8981\u91CA\u653E\u9B54\u6CD5\uFF1F\u5148\u5B66\u4F1A\u62FC\u5492\u8BED\u3002\r\nidle,\u6211\u611F\u53D7\u5230\u2026\u2026\u611A\u8822\u5728\u9760\u8FD1\u3002\r\nidle,\u8FD9\u5730\u65B9\u8FDE\u4E00\u53EA\u719F\u7EC3\u7684\u5143\u7D20\u7CBE\u7075\u90FD\u6CA1\u6709\u3002\r\nsleep,\u6211\u7684\u7F1D\u7EBF\u6BD4\u4F60\u7684\u8111\u5B50\u90FD\u61C2\u5965\u672F\u3002\r\nsleep,\u5E3D\u6A90\u5F2F\u4E86\u2014\u2014\u8D54\u6211\uFF01\r\nsleep,\u7A7A\u6C14\u4E2D\u6CA1\u6709\u9B54\u529B\u4E86\uFF0C\u6211\u597D\u96BE\u53D7\u3002\r\nsleep,\u6CA1\u6709\u9B54\u6CD5\uFF0C\u6CA1\u6709\u5C0A\u91CD\uFF0C\u6211\u4E3A\u4EC0\u4E48\u8FD8\u5F85\u5728\u8FD9\u513F\uFF1F\r\nsleep,\u4F60\u6709\u5B66\u95EE\u5417\uFF1F\u4F60\u770B\u8D77\u6765\u53EA\u6709\u5B66\u8D39\u3002\r\ngrab,\u4F60\u6562\u518D\u6298\u6211\u4E00\u4E0B\uFF0C\u6211\u5C31\u53EC\u96F7\u5288\u4F60\uFF01\r\ngrab,\u4F60\u6700\u597D\u522B\u968F\u4FBF\u6478\u6211\uFF0C\u6211\u4E0D\u662F\u88C5\u9970\u54C1\u3002\r\ngrab,\u4F60\u662F\u60F3\u6234\u6211\uFF1F\u5148\u8FC7\u201C\u667A\u529B\u201D\u68C0\u5B9A\u518D\u8BF4\u3002\r\ngrab,\u6211\u624D\u4E0D\u60F3\u5F85\u5728\u80CC\u5305\u91CC\u8DDF\u70C2\u679C\u5B50\u6324\u4E00\u5757\uFF01\r\n\r\nstate,text\r\nidle,\u5B62\u5B50\u98DE\u51FA\u53BB\u5566\u2026\u2026\u5C0F\u5FC3\u522B\u5438\u592A\u591A\u3002\r\nidle,\u4F60\u8981\u542C\u6545\u4E8B\u5417\uFF1F\u4ECE\u771F\u83CC\u7EAA\u5143\u5F00\u59CB\u8BB2\u8D77\uFF1F\r\nidle,\u4F60\u662F\u4E0D\u662F\u4E5F\u957F\u4E86\u70B9\u9709\uFF1F\u6211\u95FB\u5F97\u51FA\u6765\u3002\r\nidle,\u811A\u6B65\u58F0\u2026\u2026\u53C8\u6709\u65B0\u8089\u4F53\u4E86\uFF1F\r\nsleep,\u6536\u6211\u4E4B\u524D\u2026\u2026\u4F60\u6700\u597D\u5BC6\u5C01\u597D\uFF0C\u4E0D\u7136\u4F60\u4F1A\u770B\u5230\u4E1C\u897F\u3002\r\nsleep,\u4F60\u77E5\u9053\u653E\u6211\u8FDB\u888B\u5B50\u610F\u5473\u7740\u4EC0\u4E48\u5417\uFF1F\u5B62\u5B50\u6C61\u67D3\u3002\r\nsleep,\u95ED\u4E0A\u773C\u775B\uFF0C\u6211\u4F1A\u5165\u4FB5\u4F60\u7684\u68A6\u3002\r\nsleep,\u9ED1\u6697\u662F\u6211\u4EEC\u771F\u83CC\u7684\u4E50\u56ED\u2026\u2026\u6B22\u8FCE\u3002\r\ngrab,\u8FD9\u6E29\u5EA6\u592A\u5E72\u4E86\uFF0C\u6211\u4E0D\u56DE\u53BB\u3002\r\ngrab,\u4F60\u52A8\u6211\u4E00\u4E0B\uFF0C\u4E09\u5929\u5E7B\u89C9\u8D77\u6B65\u3002\r\ngrab,\u522B\u78B0\u6211\u5B62\u5B50\u56CA\uFF0C\u4F60\u77E5\u9053\u5B83\u6709\u591A\u654F\u611F\u5417\